# ==========================================================
# CẤU HÌNH CẢNH BÁO TRELLO SANG TELEGRAM
# ==========================================================

# 1. Cấu hình Trello API
# Lấy API Key tại: https://trello.com/app-key
TRELLO_API_KEY=your_trello_api_key_here

# Sau khi có API Key, bấm vào liên kết Token (hoặc tạo manual token) trên cùng trang đó:
TRELLO_TOKEN=your_trello_token_here

# Danh sách ID bảng Trello cần quét (phân cách bằng dấu phẩy).
# Nếu để trống, hệ thống sẽ quét TẤT CẢ các bảng còn hoạt động của bạn!
# Bạn có thể chạy lệnh: python main.py --list-boards để lấy danh sách ID các bảng.
TRELLO_BOARD_IDS=

# 2. Cấu hình Telegram Bot
# Tạo bot với @BotFather trên Telegram để nhận Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ID người dùng hoặc nhóm nhận tin nhắn (ví dụ: 123456789 hoặc -1001234567890 cho group)
# Có thể nhắn /start cho bot @userinfobot hoặc @RawDataBot để lấy Chat ID của bạn.
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 3. Cấu hình thời gian cảnh báo
# Số giờ trước khi hết hạn để kích hoạt cảnh báo (ví dụ: 24 = cảnh báo trước 24 tiếng)
HOURS_BEFORE_DUE=24

# Có gửi cảnh báo các task đã quá hạn không? (true / false)
INCLUDE_OVERDUE=true

# Giới hạn số giờ quá hạn tối đa để cảnh báo (ví dụ: 72 = quá hạn trong vòng 3 ngày).
# Tránh gửi cảnh báo các task quá hạn từ nhiều tháng trước gây spam.
MAX_OVERDUE_HOURS=72

# Khoảng cách giữa các lần nhắc lại (giờ) nếu task vẫn chưa hoàn thành
# Đặt 0 nếu chỉ muốn gửi đúng 1 lần cho mỗi trạng thái
REMIND_INTERVAL_HOURS=12

# Tần suất kiểm tra định kỳ khi chạy chế độ nền (phút)
CHECK_INTERVAL_MINUTES=30

# Múi giờ hiển thị thời gian trong tin nhắn (mặc định Việt Nam)
TIMEZONE=Asia/Ho_Chi_Minh

# Định dạng gửi tin nhắn: "detailed" (gửi từng thẻ chi tiết) hoặc "summary" (tổng hợp 1 tin nhắn) hoặc "both"
SEND_MODE=detailed
